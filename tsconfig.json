{
  "compilerOptions": {
    "module": "preserve",
    "target": "es2022",
    "types": ["node"],
    "noEmit": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "noUnusedParameters": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@src/*": ["./src/*"],
      "@controllers/*": ["./src/api/controllers/*"],
      "@testData/*": ["./testData/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "testData/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "test-results", "playwright-report"]
}
